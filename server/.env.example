# Twilio (console.twilio.com) — account must be upgraded (payment method added)
# to call numbers that aren't pre-verified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Testing safety override: every call dials this number instead of the shop's
# real number, regardless of which shop was selected. Set to your own phone.
TEST_CALL_PHONE_NUMBER=

# Anthropic API key for the call-agent's conversation logic (server-side only).
ANTHROPIC_API_KEY=

# Public HTTPS base URL Twilio can reach — your ngrok URL during local dev
# (e.g. https://abcd1234.ngrok-free.app), or your deployed backend URL later.
PUBLIC_BASE_URL=

PORT=3001

# Hard cap on call length in milliseconds. 60000 = 1 minute, per current plan.
CALL_HARD_CAP_MS=60000
